  "drafts": {
    "draft_mvav256v_195i0": {
      "id": "draft_mvav256v_195i0",
      "emailId": "eval_tech_001",
      "category": "technical_support",
      "proposedBody": "Hello Marcus Vance,\n\nThank you for reaching out to Brilliant Directories Support.\n\nRegarding your inquiry about \"SSL Certificate failing on custom domain directorypro.com\":\n\nTo connect your live domain, navigate to Settings > Domain Manager in your admin dashboard. Enter your custom domain and point your DNS A Record to the Brilliant Directories server IP.\n\nFor detailed documentation and step-by-step guidance, please review the official Solution Center guide:\n• Guide 1. How to Connect a Live Domain Name: https://support.brilliantdirectories.com/support/solutions/articles/12000065940-guide-1-how-to-connect-a-live-domain-name\n\nYou can also reference the accompanying configuration screenshot:\n• Domain Manager wizard setup screen: https://s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/12185668534/original/woU8C814_2yX08ziBJcQcO-54kLJi2FC_g.png?1790182288\n\nIf you need any further assistance configuring your directory, please let us know.\n\nBest regards,\nBrilliant Directories Technical Support\nBrilliant Directories Support & Technical Consulting",
      "supportingSources": [
        {
          "title": "Guide 1. How to Connect a Live Domain Name",
          "url": "https://support.brilliantdirectories.com/support/solutions/articles/12000065940-guide-1-how-to-connect-a-live-domain-name",
          "snippet": "The current Domain Manager guides the entire connection through up to four stages: Choose An Address, Check It, Point Domain, and Switch Over.",
          "score": 0.88,
          "section": "Domain Setup",
          "images": [
            {
              "url": "https://s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/12185668534/original/woU8C814_2yX08ziBJcQcO-54kLJi2FC_g.png?1790182288",
              "caption": "Domain Manager wizard setup screen"
            }
          ]
        }
      ],
      "supportingImages": [
        {
          "url": "https://s3.amazonaws.com/cdn.freshdesk.com/data/helpdesk/attachments/production/12185668534/original/woU8C814_2yX08ziBJcQcO-54kLJi2FC_g.png?1790182288",
          "caption": "Domain Manager wizard setup screen"
        }
      ],
      "internalExplanation": "Grounded in Brilliant Directories Solution Center documentation (Guide 1. How to Connect a Live Domain Name).",
      "uncertaintyWarnings": [],
      "humanReviewRequired": true,
      "autoSendEligible": true,
      "createdAt": "2026-10-16T11:04:52.423Z",
      "updatedAt": "2026-10-16T11:04:52.423Z"
    },
    "draft_mvav2578_66lmt": {
      "id": "draft_mvav2578_66lmt",
      "emailId": "eval_tech_002",
      "category": "technical_support",
      "proposedBody": "Hello Elena Rostova,\n\nThank you for reaching out to Brilliant Directories Support.\n\nRegarding your inquiry about \"Webhook endpoint returning HTTP 500 on member signup\":\n\nWebhooks can be configured under Developer Hub > Webhooks. Brilliant Directories supports outbound webhooks with HMAC SHA-256 signature verification.\n\nFor detailed documentation and step-by-step guidance, please review the official Solution Center guide:\n• Developer Hub: Webhooks & API Integration: https://support.brilliantdirectories.com/support/solutions/articles/12000089012-webhooks\n\nIf you need any further assistance configuring your directory, please let us know.\n\nBest regards,\nBrilliant Directories Technical Support\nBrilliant Directories Support & Technical Consulting",
      "supportingSources": [
        {
          "title": "Developer Hub: Webhooks & API Integration",
          "url": "https://support.brilliantdirectories.com/support/solutions/articles/12000089012-webhooks",
          "snippet": "Configure event-driven webhooks for member signups, billing updates, and form submissions in Developer Tools > Webhooks.",
          "score": 0.83,
          "section": "Developer Hub",
          "images": []
        }
