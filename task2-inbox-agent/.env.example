# ==============================================================================
# Task 2: Inbox Agent Environment Configuration
# ==============================================================================

# Anthropic Claude API Configuration
# Keep MOCK_LLM=true for offline testing/evaluation without requiring an API key
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
CLAUDE_MODEL_PRIMARY=claude-3-5-sonnet-20241022
CLAUDE_MODEL_FAST=claude-3-haiku-20240307
MOCK_LLM=true

# Task 1: Knowledge Brain Integration Configuration
KB_API_URL=http://127.0.0.1:8000
KB_TIMEOUT_MS=8000
MOCK_KB=true

# Service Server Port
INBOX_PORT=3000

# Strict Sending Safety
# Defaults to false (safe simulated sends only, preventing email leaks)
ENABLE_REAL_EMAIL_SENDING=false

# Autonomy & Review Threshold Configuration
# Automatically sends ONLY after 20 consecutive unedited approved drafts in same category
AUTONOMY_STREAK_THRESHOLD=20
QUALITY_WINDOW_SIZE=10
QUALITY_MAX_EDIT_RATE=0.20
QUALITY_MAX_REJECTION_RATE=0.05

# Logging level (debug, info, warn, error)
LOG_LEVEL=info
