# ==============================================================================
# Business Labs AI Tech Consultant - Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the real .env file with active API keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Central LLM Settings (Anthropic Claude)
# ------------------------------------------------------------------------------
# Required for RAG synthesis, Inbox Agent drafts, and Scope analysis
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Primary model for deep reasoning, proposals, and grounded synthesis
CLAUDE_MODEL_PRIMARY=claude-3-5-sonnet-20241022

# Fast model for email classification, light checks, and evaluation comparison
CLAUDE_MODEL_FAST=claude-3-haiku-20240307

# Set to true to return deterministic mock LLM responses for offline testing
MOCK_LLM=false

# ------------------------------------------------------------------------------
# 2. Knowledge Brain REST API Service (Task 1)
# ------------------------------------------------------------------------------
KB_API_HOST=127.0.0.1
KB_API_PORT=8000
KB_API_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 3. Storage & Directory Overrides (Leave blank to use default ./data paths)
# ------------------------------------------------------------------------------
# KB_DATA_DIR=./data
# CHROMA_PERSIST_PATH=./data/chroma_db

# ------------------------------------------------------------------------------
# 4. Document Chunking & Vector Store Settings
# ------------------------------------------------------------------------------
# Provider: 'default' (local Chroma ONNX all-MiniLM-L6-v2), 'sentence_transformers', or 'mock'
EMBEDDING_PROVIDER=default
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=150
CHROMA_COLLECTION_NAME=bd_solution_center

# ------------------------------------------------------------------------------
# 5. Sitemap Crawler & Incremental Ingestion Settings
# ------------------------------------------------------------------------------
SITEMAP_URL=https://support.brilliantdirectories.com/support/sitemap.xml

# Max articles to crawl during sync (0 = unlimited / complete sitemap crawl)
CRAWL_MAX_ARTICLES=0

# HTTP request timeout per article in seconds
CRAWL_REQUEST_TIMEOUT=15.0

# Number of concurrent HTTP connections during article crawling
CRAWL_CONCURRENCY=5

# ------------------------------------------------------------------------------
# 5. Retrieval & Two-Tier Escalation Thresholds
# ------------------------------------------------------------------------------
# Tier 1 Gate: Minimum cosine similarity score required before escalating (0.0 to 1.0)
SIMILARITY_THRESHOLD=0.60

# Tier 2 Gate: Minimum confidence score required before flagging for human review (0.0 to 1.0)
CONFIDENCE_THRESHOLD=0.70

# ------------------------------------------------------------------------------
# 6. Article Images & Screenshots
# ------------------------------------------------------------------------------
# Maximum screenshots attached to a synthesized answer
MAX_IMAGES_PER_ANSWER=2

# ------------------------------------------------------------------------------
# 7. Human Escalation & Auto-Learning
# ------------------------------------------------------------------------------
# Whether human expert resolutions are automatically indexed into vector storage
AUTO_INDEX_RESOLVED_ESCALATIONS=true

# ------------------------------------------------------------------------------
# 8. Logging
# ------------------------------------------------------------------------------
# Allowed: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 9. Task 2 Inbox Agent Configuration (TypeScript)
# ------------------------------------------------------------------------------
INBOX_API_PORT=3000
AUTONOMY_THRESHOLD=20
AUTONOMY_WINDOW_SIZE=10
AUTONOMY_MAX_EDIT_RATE=0.25
AUTONOMY_MAX_REJECT_RATE=0.10
ENABLE_REAL_SENDING=false

# ------------------------------------------------------------------------------
# 10. Task 3 Meeting to Scope Configuration (Python)
# ------------------------------------------------------------------------------
TASK3_API_HOST=127.0.0.1
TASK3_API_PORT=8001
TASK3_DATA_DIR=./data
MOCK_KB=true
ENABLE_CLIENT_DELIVERY=false

